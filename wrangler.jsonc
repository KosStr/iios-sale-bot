// Landing page (site/public/) on Cloudflare Workers static assets, plus the
// /catalog page rendered by site/worker/index.js from catalog.json in R2.
// Deploy (from the repo root): npx wrangler deploy — every file in site/public/
// is published except those listed in site/public/.assetsignore.
// Hero images, hot.json and catalog.json live in the R2 bucket, not here.
// Billing (Free plan): static asset requests are free and unlimited, and only
// the paths in run_worker_first invoke the Worker (100k requests/day free; over
// that it errors instead of billing). Never set run_worker_first to true —
// every request would then count against the Worker limit.
// Security headers for static assets live in site/public/_headers; the Worker sets its own.
{
  "name": "store",
  "main": "site/worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "site/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/catalog", "/catalog/*", "/api/*"]
  },
  "r2_buckets": [
    { "binding": "CATALOG", "bucket_name": "iios" }
  ]
}
